# ==========================================
# SANTANA AFILIADOS BOT - VARIÁVEIS DE AMBIENTE
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key-before-use
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Banco de Dados (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=santana_afiliados_db
DB_USER=santana_admin
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Gateway WhatsApp legado usado pela publicação manual na tela Publicações
WHATSAPP_API_ENABLED=False
WHATSAPP_API_URL=http://localhost:8080/message/sendMedia/santana-bot
WHATSAPP_API_TOKEN=
# ID do grupo para o gateway de publicação manual; não usado pelo monitor Selenium.
WHATSAPP_GROUP_ID=SEU_GRUPO@g.us
WHATSAPP_GATEWAY_TYPE=evolution

# Monitor de ofertas recebidas no WhatsApp (requer sessão local do Chrome)
AFFILIATE_BOT_SOURCE_GROUP="Promozone #46"
AFFILIATE_BOT_TARGET_GROUP=
AFFILIATE_BOT_DAILY_LIMIT=20
AFFILIATE_BOT_POLL_INTERVAL_SECONDS=10
AFFILIATE_BOT_MIN_INTERVAL_SECONDS=120
AFFILIATE_BOT_CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222

# Regras de Negócio e Pontuação
BUDGET_MAX_PREFERENTIAL=200.00
DEFAULT_COMMISSION_PERCENTAGE=8.0
