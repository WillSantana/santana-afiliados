# ==========================================
# SANTANA AFILIADOS BOT - VARIÁVEIS DE AMBIENTE
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key-before-use
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Banco de Dados (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=santana_afiliados_db
DB_USER=santana_admin
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Mercado Livre API
MERCADOLIVRE_API_URL=https://api.mercadolibre.com
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Configure a valid OAuth access token to search real listings.
MERCADOLIVRE_ACCESS_TOKEN=

# WhatsApp Integration (Evolution API / Z-API / Webhook)
WHATSAPP_API_ENABLED=False
WHATSAPP_API_URL=http://localhost:8080/message/sendMedia/santana-bot
WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=SEU_GRUPO@g.us
WHATSAPP_GATEWAY_TYPE=evolution

# Regras de Negócio e Pontuação
BUDGET_MAX_PREFERENTIAL=200.00
DEFAULT_COMMISSION_PERCENTAGE=8.0
