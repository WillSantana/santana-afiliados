{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/ofertas.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=30, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/oferta/:id", "destination": "/api/oferta?id=:id" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
